# ==========================================
# TelegramWarden Configuration Environment
# ==========================================

# Telegram Bot Credentials
BOT_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXYZ_1234567
BOT_USERNAME=TelegramWardenBot

# SuperAdmin Telegram User IDs (comma-separated, full bypass and settings access)
SUPERADMIN_IDS=123456789,987654321

# AI Engine (Primary: DeepSeek V3/Flash, Fallback: Groq / OpenRouter / OpenAI)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Fallback AI (Groq / OpenRouter / OpenAI)
FALLBACK_AI_ENABLED=true
FALLBACK_API_KEY=gsk_your_groq_or_openai_api_key_here
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=llama-3.3-70b-versatile

# Tier-1 fast triage (TypeSafe Jev). Optional: leave disabled and the bot
# calls DeepSeek directly as before. Fast-pass threshold is conservative
# (0.03) until calibrated on real traffic logs (logs/jev_triage.jsonl).
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_FAST_PASS_THRESHOLD=0.03
JEV_TIMEOUT_SECONDS=2.5
JEV_MAX_CONCURRENT=10

# PostgreSQL Database (AsyncPG)
POSTGRES_USER=warden_user
POSTGRES_PASSWORD=warden_secure_password
POSTGRES_DB=warden_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://warden_user:warden_secure_password@localhost:5432/warden_db

# Redis Cache & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# FastAPI Backend & WebApp Settings
API_HOST=0.0.0.0
API_PORT=2009
SECRET_KEY=generate_a_random_32_byte_secret_key_for_sessions
WEBAPP_URL=https://your-domain.com

# Optional Cloudflare Tunnel Token (Free permanent HTTPS domain)
CLOUDFLARE_TUNNEL_TOKEN=


# Admin Log Channel (for audit cards and feedback)
DEFAULT_LOG_CHANNEL_ID=-1001234567890

# Data Retention & Maintenance (Days)
WARN_EXPIRATION_DAYS=7
LOGS_RETENTION_DAYS=30
MESSAGE_CACHE_HOURS=24

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
